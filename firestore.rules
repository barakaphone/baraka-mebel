rules_version = '2';

// ============================================================================
//  Baraka Mebel — Firestore xavfsizlik qoidalari (2-versiya: ruxsatlar asosida)
//  Firebase konsoli → Firestore Database → Rules: eski matnni TO'LIQ o'chirib,
//  shu faylni joylang va "Publish" bosing.
//
//  Har bir amal rol nomiga emas, rolga berilgan RUXSATGA qarab tekshiriladi.
//  Rollar va ruxsatlar: settings/roles (Sozlamalar → Rollar). Hujjat hali yo'q
//  bo'lsa, pastdagi standart ruxsatlar ishlaydi (js/perms.js bilan bir xil).
//   • Tizim egasi — hammasi.  • Admin — hammasi ("usta foizi"dan tashqari).
//  Narxlar orders/{id}/pul/main da, usta foizi ustaFoiz/{uid} da — ruxsati yo'q
//  xodim (masalan usta, o'lchovchi) ularni o'qiy olmaydi.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Yordamchi funksiyalar ----------
    function signedIn()   { return request.auth != null; }
    function uid()        { return request.auth.uid; }
    function profPath()   { return /databases/$(database)/documents/profiles/$(request.auth.uid); }
    function me()         { return get(profPath()).data; }
    function isStaff()    { return signedIn() && exists(profPath()) && me().active == true && me().get('deleted', false) != true; }
    function isAdmin()    { return isStaff() && me().role == 'admin'; }
    function myBranch()   { return me().branchId; }
    function setupPath()  { return /databases/$(database)/documents/meta/setup; }
    function setupDone()  { return exists(setupPath()); }
    function ownerUid()   { return setupDone() && get(setupPath()).data.by == uid(); }
    function isOwner()    { return isAdmin() && ownerUid(); }
    function newData()    { return request.resource.data; }
    function changed()    { return request.resource.data.diff(resource.data).affectedKeys(); }
    function str(v, max)  { return v is string && v.size() <= max; }
    function orderPath(id) { return /databases/$(database)/documents/orders/$(id); }
    function pulPath(id)   { return /databases/$(database)/documents/orders/$(id)/pul/main; }
    function rolesPath()   { return /databases/$(database)/documents/settings/roles; }

    // Standart ruxsatlar (settings/roles yo'q bo'lsa yoki unda rol bo'lmasa)
    function defaultPerms(r) {
      return {
        'rahbar': {'ord_all': true, 'calc': true, 'see_cost': true, 'pdf': true, 'assign_usta': true, 'kirim': true, 'xom_narx': true,
                   'add_usta': true, 'see_usta_foiz': true, 'staff_view': true, 'final_pdf': true},
        'sotuvchi': {'ord_branch': true, 'ord_create': true, 'ord_edit': true, 'ord_cancel': true, 'calc': true,
                     'discount': true, 'pdf': true, 'pasport_view': true, 'pasport_upload': true},
        'shartnomachi': {'skoring': true, 'pasport_view': true},
        'olchovchi': {'olchov': true},
        'usta': {'work': true}
      }.get(r, {});
    }
    function roleMap(r) {
      return exists(rolesPath()) && r in get(rolesPath()).data.roles
        ? get(rolesPath()).data.roles[r].get('perms', {})
        : defaultPerms(r);
    }
    // Ruxsat: p — xodim profili, pm — uning roli ruxsatlari (bir marta hisoblanadi), own — tizim egasimi.
    // Admin: "see_usta_foiz" dan boshqa hammasi (u faqat Rollar bo'limida yoqilsa).
    function hp(p, pm, own, k) {
      return own || (p.role == 'admin' && k != 'see_usta_foiz') || pm.get(k, false) == true;
    }
    // Har bir qoidada: rule(me(), roleMap(me().role), ownerUid(), ...)
    // Ustalar ro'yxatidagi xodim: rolida "work" ruxsati bor
    function workRole(p)  { return p.role != 'admin' && roleMap(p.role).get('work', false) == true; }

    // ---------- Buyurtmani yangilash: kim nimani o'zgartira oladi ----------
    // Bosqichlar: murojaat → skoring (muddatli) → olchov → ustaga → usta_narx → mijoz_tasdiq → kirim
    //   → shartnoma (muddatli) → usta_tasdiq → kesish → yigish → qadoqlash → yetkazish → yakunlandi
    function preStages()  { return ['murojaat', 'skoring', 'olchov', 'olchandi', 'ustaga', 'usta_narx', 'mijoz_tasdiq', 'kirim', 'shartnoma']; }
    function prodStages() { return ['kesish', 'yigish', 'qadoqlash', 'yetkazish']; }
    function canUpdate(p, pm, own, o, n, ch, oid) {
      return p.role == 'admin'
        || (hp(p, pm, own, 'ord_edit') && (hp(p, pm, own, 'ord_all') || o.branchId == p.branchId)
            && (sellerUpd(p, pm, own, o, n, ch, oid) || sellerMuddat(o, n, ch)))
        || (hp(p, pm, own, 'skoring') && shartUpd(o, n, ch, oid))
        || (hp(p, pm, own, 'olchov') && olchUpd(o, n, ch))
        || (hp(p, pm, own, 'assign_usta') && (rahbarUpd(o, n, ch) || muddatUpd(o, n, ch)
                                              || (hp(p, pm, own, 'calc') && rahbarNarx(o, n, ch))))
        || (hp(p, pm, own, 'kirim') && kirimUpd(o, n, ch))
        || (hp(p, pm, own, 'work') && o.ustaId == uid() && (ustaUpd(o, n, ch) || muddatUpd(o, n, ch)))
        || (hp(p, pm, own, 'report') && ch.hasOnly(['reportHidden']));
    }
    function workerOnly(ch, keys) { return ch.hasOnly(keys.concat(['stage', 'updatedAt', 'log', 'stageAt', 'stageBy'])); }
    function move(o, n, a, b)     { return o.stage == a && n.stage == b; }
    // Sotuvchi: usta, o'lchov, kirim va muddat maydonlariga tegmaydi
    function sellerUpd(p, pm, own, o, n, ch, oid) {
      return n.branchId == o.branchId
        && !ch.hasAny(['no', 'branchId', 'ustaId', 'ustaName', 'olchov', 'createdAt', 'yetkazildi', 'muddat', 'muddatTarix',
                       'reportHidden', 'kirimInfo', 'ustaEtiroz', 'muddatTasdiq'])
        && (!ch.hasAny(['mebelTuri']) || o.stage == 'murojaat')
        && (!ch.hasAny(['tolovTuri']) || (o.stage in preStages() && n.tolovTuri in ['naqd', 'muddatli']))
        && sellerMove(p, pm, own, o, n, oid);
    }
    function sellerMove(p, pm, own, o, n, oid) {
      return (n.stage == o.stage && o.stage in preStages())
        || ((move(o, n, 'murojaat', 'bekor') || move(o, n, 'mijoz_tasdiq', 'bekor')) && hp(p, pm, own, 'ord_cancel'))
        // muddatli: skoringga (rasmiylashtirish, narx limitdan oshishi, to'lov turini almashtirish)
        || (n.stage == 'skoring' && o.stage in preStages() && n.tolovTuri == 'muddatli')
        // naqdga o'tkazilsa — skoringdan chiqadi
        || (o.stage == 'skoring' && n.tolovTuri == 'naqd' && n.stage in ['olchov', 'ustaga', 'usta_narx', 'mijoz_tasdiq', 'kirim'])
        || (move(o, n, 'murojaat', 'olchov') && n.tolovTuri == 'naqd' && n.mebelTuri != 'tayyor' && n.olchovchiId != '')
        || (move(o, n, 'murojaat', 'ustaga') && n.tolovTuri == 'naqd' && n.mebelTuri == 'tayyor')
        || (move(o, n, 'olchandi', 'ustaga') && (n.tolovTuri == 'naqd' || withinLimit(get(pulPath(oid)).data)))
        || move(o, n, 'mijoz_tasdiq', 'kirim')
        || move(o, n, 'shartnoma', 'usta_tasdiq');
    }
    // Sotuvchi: usta o'zgartirgan muddatga mijoz javobi (rozi emas — eski sana qaytadi)
    function sellerMuddat(o, n, ch) {
      return o.stage in prodStages() && n.stage == o.stage
        && o.get('muddatTasdiq', {'holat': ''}).holat == 'kutilmoqda'
        && ch.hasOnly(['muddatTasdiq', 'muddat', 'muddatTarix', 'updatedAt', 'log'])
        && (!ch.hasAny(['muddat']) || n.muddat == o.muddatTasdiq.eski);
    }
    function withinLimit(pul) { return pul.result.tanlangan.qoldiq <= pul.skoring.limit; }
    // Shartnomachi: faqat qaror (pul/main dagi skoring bilan bitta paketda)
    function shartUpd(o, n, ch, oid) {
      return o.stage == 'skoring' && o.tolovTuri == 'muddatli' && workerOnly(ch, ['bekorSabab', 'skQaytish'])
        && n.stage in ['olchov', 'ustaga', 'bekor', 'usta_narx', 'mijoz_tasdiq', 'kirim', 'shartnoma', 'usta_tasdiq']
        && skoringMatches(getAfter(pulPath(oid)).data.skoring, n.stage);
    }
    function skoringMatches(sk, stage) { return sk.by == uid() && sk.qaror == (stage == 'bekor' ? 'bekor' : 'tasdiq'); }
    // O'lchovchi: faqat o'ziga biriktirilgan o'lchov
    function olchUpd(o, n, ch) {
      return o.olchovchiId == uid() && o.stage == 'olchov' && n.stage in ['olchandi', 'ustaga'] && workerOnly(ch, ['olchov'])
        && n.olchov.u == uid() && str(n.olchov.izoh, 3000);
    }
    // Rahbar: ustaga biriktirish yoki almashtirish (usta haqi pul/main ga yoziladi); e'tirozda qayta o'lchovga
    function rahbarUpd(o, n, ch) {
      return (o.stage in ['ustaga', 'usta_narx', 'usta_tasdiq'] && n.stage in ['usta_narx', 'usta_tasdiq']
              && workerOnly(ch, ['ustaId', 'ustaName', 'ustaEtiroz'])
              && workRole(get(/databases/$(database)/documents/profiles/$(n.ustaId)).data))
        || (move(o, n, 'usta_narx', 'olchov') && workerOnly(ch, ['ustaEtiroz']));
    }
    // Muddatni o'zgartirish (usta yoki rahbar): bosqich o'zgarmaydi, sababi tarixga yoziladi
    function muddatUpd(o, n, ch) {
      return o.stage in prodStages() && n.stage == o.stage
        && ch.hasOnly(['muddat', 'muddatTarix', 'muddatTasdiq', 'updatedAt', 'log']) && ch.hasAll(['muddat', 'muddatTarix'])
        && n.muddat is string && n.muddatTarix.size() == o.get('muddatTarix', []).size() + 1;
    }
    // Rahbar: usta bosqichlarida mebel narxini o'zgartirish (limitdan oshsa — shartnomachiga qaytadi)
    function rahbarNarx(o, n, ch) {
      return o.stage in ['ustaga', 'usta_narx', 'usta_tasdiq']
        && ch.hasOnly(['hasCalc', 'ish', 'taklifUstaId', 'taklifUstaName', 'updatedAt', 'log', 'stage', 'stageAt', 'skQaytish'])
        && (n.stage == o.stage || (n.stage == 'skoring' && o.tolovTuri == 'muddatli'));
    }
    // Admin / rahbar: mahsulotni kirim qilish → muddatlida shartnomaga, naqdda ustaga
    function kirimUpd(o, n, ch) {
      return o.stage == 'kirim' && workerOnly(ch, ['kirimInfo'])
        && ((n.stage == 'shartnoma' && o.tolovTuri == 'muddatli') || (n.stage == 'usta_tasdiq' && o.tolovTuri != 'muddatli'));
    }
    // Usta: o'lchov va narxga rozilik (yoki e'tiroz), so'ng o'z ishining bosqichlari ketma-ket
    function ustaUpd(o, n, ch) {
      return workerOnly(ch, ['yetkazildi', 'muddat', 'ustaEtiroz'])
        && (!ch.hasAny(['muddat']) || move(o, n, 'usta_tasdiq', 'kesish'))
        && (move(o, n, 'usta_narx', 'mijoz_tasdiq') || (o.stage == 'usta_narx' && n.stage == 'usta_narx' && ch.hasOnly(['ustaEtiroz', 'updatedAt', 'log']))
            || move(o, n, 'usta_tasdiq', 'kesish') || move(o, n, 'kesish', 'yigish') || move(o, n, 'yigish', 'qadoqlash')
            || move(o, n, 'qadoqlash', 'yetkazish') || move(o, n, 'yetkazish', 'yakunlandi'));
    }

    // ---------- Tizimni birinchi sozlash ----------
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !setupDone()
                    && newData().keys().hasOnly(['by', 'at'])
                    && newData().by == uid()
                    && getAfter(profPath()).data.role == 'admin';
      allow update, delete: if false;
    }
    match /meta/counter {
      allow read: if isStaff();
      allow create: if isStaff() && newData().keys().hasOnly(['n']) && newData().n == 1;
      allow update: if isStaff() && newData().keys().hasOnly(['n']) && newData().n == resource.data.n + 1;
    }
    match /meta/migr {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---------- Xodimlar ----------
    match /profiles/{pid} {
      allow read: if isStaff() || (signedIn() && pid == uid());
      allow create: if (isAdmin() && pid != uid() && (!('canManageRoles' in newData()) || isOwner()))
                    || (isStaff() && hp(me(), roleMap(me().role), false, 'add_usta') && workRole(newData()) && pid != uid() && !('canManageRoles' in newData()))
                    || (signedIn() && pid == uid() && !setupDone() && newData().role == 'admin'
                        && getAfter(setupPath()).data.by == uid());
      allow update: if (isAdmin()
                        && (get(setupPath()).data.by != pid || isOwner())
                        && (pid != uid() || !changed().hasAny(['role', 'active', 'branchId', 'replacedBy', 'deleted']))
                        && (!changed().hasAny(['canManageRoles']) || isOwner()))
                    || (isStaff() && hp(me(), roleMap(me().role), false, 'add_usta') && workRole(resource.data) && workRole(newData())
                        && !changed().hasAny(['login', 'replacedBy', 'alias', 'canManageRoles']))
                    || (isStaff() && pid == uid() && changed().hasOnly(['seen']));
      allow delete: if false;
    }
    // Usta xizmat foizi — faqat ruxsati bor xodimlar o'qiydi (hisob uchun kalkulyator ham)
    match /ustaFoiz/{pid} {
      allow read: if isStaff() && foizRead(me(), roleMap(me().role), ownerUid());
      allow write: if isOwner() || (isStaff() && foizWrite(me(), roleMap(me().role), ownerUid()));
      function foizRead(p, pm, own)  { return p.role == 'admin' || hp(p, pm, own, 'see_usta_foiz') || hp(p, pm, own, 'calc') || hp(p, pm, own, 'assign_usta') || hp(p, pm, own, 'report'); }
      function foizWrite(p, pm, own) { return hp(p, pm, own, 'see_usta_foiz') && hp(p, pm, own, 'add_usta'); }
    }

    // ---------- Sozlamalar va filiallar ----------
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if (id in ['main', 'kalk'] && isAdmin())
                   || (id == 'xom' && isStaff() && hp(me(), roleMap(me().role), ownerUid(), 'xom_narx'))
                   || (id == 'roles' && (isOwner() || (isAdmin() && me().get('canManageRoles', false) == true)));
    }
    match /branches/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---------- Buyurtmalar ----------
    match /orders/{oid} {
      function ordRead(p, pm, own, o) {
        return p.role == 'admin' || hp(p, pm, own, 'ord_all')
          || (hp(p, pm, own, 'ord_branch') && o.branchId == p.branchId)
          || (hp(p, pm, own, 'skoring') && o.tolovTuri == 'muddatli')
          || (hp(p, pm, own, 'olchov') && o.olchovchiId == uid())
          || (hp(p, pm, own, 'work') && o.ustaId == uid());
      }
      function ordCreate(p, pm, own, n) {
        return p.role == 'admin'
          || (hp(p, pm, own, 'ord_create') && (hp(p, pm, own, 'ord_all') || n.branchId == p.branchId)
              && n.sellerId == uid() && n.stage == 'murojaat' && n.ustaId == '' && !('olchov' in n));
      }
      allow read: if isStaff() && ordRead(me(), roleMap(me().role), ownerUid(), resource.data);
      allow create: if isStaff() && ordCreate(me(), roleMap(me().role), ownerUid(), newData());

      // Rol va o'zgargan maydonlar bir marta hisoblanib, funksiyalarga uzatiladi
      allow update: if isStaff() && canUpdate(me(), roleMap(me().role), ownerUid(), resource.data, newData(), changed(), oid);
      allow delete: if isOwner();

      // ---------- Narx, to'lov, shartnoma qarori, usta haqi ----------
      match /pul/{pid} {
        function ord()      { return get(orderPath(oid)).data; }
        function ordAfter() { return getAfter(orderPath(oid)).data; }
        function sameUsta() {
          return newData().get('ustaHaqi', null) == resource.data.get('ustaHaqi', null)
            && newData().get('ustaFoiz', null) == resource.data.get('ustaFoiz', null)
            && newData().get('ustaId', null) == resource.data.get('ustaId', null);
        }
        function pulRead(p, pm, own, d) {
          return p.role == 'admin' || hp(p, pm, own, 'ord_all') || hp(p, pm, own, 'assign_usta') || hp(p, pm, own, 'report') || hp(p, pm, own, 'kirim')
            || (hp(p, pm, own, 'ord_branch') && d.branchId == p.branchId)
            || (hp(p, pm, own, 'skoring') && ord().tolovTuri == 'muddatli');
        }
        function pulCreate(p, pm, own, n) {
          return p.role == 'admin'
            || (hp(p, pm, own, 'ord_edit') && (hp(p, pm, own, 'ord_all') || n.branchId == p.branchId)
                && ordAfter().branchId == n.branchId
                && ordAfter().stage == 'murojaat' && !('skoring' in n) && !('ustaHaqi' in n));
        }
        function pulUpdate(p, pm, own, d, n) {
          return p.role == 'admin'
            || (hp(p, pm, own, 'ord_edit') && (hp(p, pm, own, 'ord_all') || d.branchId == p.branchId)
                && n.branchId == d.branchId && ordAfter().stage in preStages()
                && n.get('skoring', null) == d.get('skoring', null) && n.get('kirim', null) == d.get('kirim', null) && sameUsta())
            || (hp(p, pm, own, 'skoring') && ord().stage == 'skoring' && ord().tolovTuri == 'muddatli'
                && changed().hasOnly(['skoring']) && n.skoring.by == uid() && n.skoring.qaror in ['tasdiq', 'bekor'])
            || (hp(p, pm, own, 'assign_usta') && ord().stage in ['ustaga', 'usta_narx', 'usta_tasdiq']
                && changed().hasOnly(['ustaId', 'ustaHaqi', 'ustaFoiz']))
            || (hp(p, pm, own, 'kirim') && ord().stage == 'kirim' && changed().hasOnly(['kirim']))
            || (hp(p, pm, own, 'assign_usta') && hp(p, pm, own, 'calc') && ord().stage in ['ustaga', 'usta_narx', 'usta_tasdiq']
                && n.branchId == d.branchId && n.get('skoring', null) == d.get('skoring', null)
                && n.get('ustaId', null) == d.get('ustaId', null) && n.get('ustaFoiz', null) == d.get('ustaFoiz', null));
        }
        allow read: if isStaff() && pulRead(me(), roleMap(me().role), ownerUid(), resource.data);
        allow create: if pid == 'main' && isStaff() && pulCreate(me(), roleMap(me().role), ownerUid(), newData());
        allow update: if pid == 'main' && isStaff() && pulUpdate(me(), roleMap(me().role), ownerUid(), resource.data, newData());
        allow delete: if false;
      }
    }
    // Usta haqi summasi — biriktirilgan ustaning o'zi ko'radi (foizini emas)
    match /orders/{oid}/usta/{x} {
      allow read: if isStaff() && (me().role == 'admin' || hp(me(), roleMap(me().role), ownerUid(), 'see_usta_foiz')
                                   || hp(me(), roleMap(me().role), ownerUid(), 'assign_usta')
                                   || get(orderPath(oid)).data.ustaId == uid());
      allow write: if x == 'main' && isStaff() && (me().role == 'admin' || hp(me(), roleMap(me().role), ownerUid(), 'assign_usta'))
                   && request.resource.data.keys().hasOnly(['ustaId', 'haqi']);
    }
    // Hisobot va bosh sahifa (barcha buyurtmalar narxi)
    match /{path=**}/pul/{pid} {
      allow read: if isStaff() && (me().role == 'admin' || hp(me(), roleMap(me().role), ownerUid(), 'ord_all')
                                   || hp(me(), roleMap(me().role), ownerUid(), 'report'));
    }

    // ---------- Rasmlar (pasport, o'lchov, yetkazish) ----------
    match /photos/{id} {
      function ordOf(o) { return get(orderPath(o)).data; }
      function mediaStage(k, st) {
        return (k == 'tasdiq' && st == 'mijoz_tasdiq') || (k == 'shartnoma' && st == 'shartnoma')
          || (k == 'muddat' && st in ['kesish', 'yigish', 'qadoqlash', 'yetkazish']);
      }
      function phRead(p, pm, own, d) {
        return p.role == 'admin' || d.kind != 'pasport'
          || (hp(p, pm, own, 'pasport_view') && (hp(p, pm, own, 'ord_all') || hp(p, pm, own, 'skoring') || d.branchId == p.branchId));
      }
      function phCreate(p, pm, own, n) {
        return p.role == 'admin'
          || (n.kind == 'pasport' && hp(p, pm, own, 'pasport_upload')
              && (hp(p, pm, own, 'ord_all') || n.branchId == p.branchId)
              && n.side in ['oldi', 'orqa'] && ordOf(n.orderId).stage in ['murojaat', 'skoring'])
          || (n.kind == 'olchov' && hp(p, pm, own, 'olchov') && ordOf(n.orderId).olchovchiId == uid()
              && ordOf(n.orderId).stage == 'olchov')
          || (n.kind == 'yetkazish' && hp(p, pm, own, 'work') && ordOf(n.orderId).ustaId == uid()
              && ordOf(n.orderId).stage == 'yetkazish')
          // Mijoz tasdig'i (narx / yangi muddat) va shartnoma — sotuvchi; kirim hujjati — kirim ruxsati borlar
          || (n.kind in ['tasdiq', 'shartnoma', 'muddat'] && hp(p, pm, own, 'ord_edit')
              && (hp(p, pm, own, 'ord_all') || n.branchId == p.branchId) && mediaStage(n.kind, ordOf(n.orderId).stage))
          || (n.kind == 'kirim' && hp(p, pm, own, 'kirim') && ordOf(n.orderId).stage == 'kirim');
      }
      allow read: if isStaff() && phRead(me(), roleMap(me().role), ownerUid(), resource.data);
      allow create: if isStaff() && newData().createdBy == uid()
                    && newData().keys().hasOnly(['orderId', 'branchId', 'kind', 'side', 'data', 'createdBy', 'createdAt'])
                    && str(newData().data, 400000)
                    && newData().branchId == ordOf(newData().orderId).branchId
                    && phCreate(me(), roleMap(me().role), ownerUid(), newData());
      allow update: if false;
      allow delete: if isAdmin() || (isStaff() && resource.data.createdBy == uid());
    }

    // ---------- Bildirishnomalar (🔔) ----------
    match /notifs/{nid} {
      allow read: if isStaff() && resource.data.to == uid();
      allow create: if isStaff() && newData().by == uid() && newData().read == false && newData().to is string && newData().to != uid()
                    && newData().keys().hasOnly(['to', 'orderId', 'orderNo', 'client', 'kind', 'text', 'by', 'byName', 'at', 'read'])
                    && str(newData().text, 500);
      allow update: if isStaff() && resource.data.to == uid() && changed().hasOnly(['read']);
      allow delete: if isStaff() && (resource.data.to == uid() || isAdmin());
    }

    // ---------- Muammolar (har bir muammo alohida mavzu) ----------
    match /topics/{tid} {
      allow read: if isStaff();
      allow create: if isStaff() && newData().by == uid() && newData().status == 'open' && newData().replies == 0
                    && newData().keys().hasOnly(['title', 'text', 'by', 'byName', 'byRole', 'branchId', 'orderId', 'orderNo',
                                                 'photo', 'status', 'replies', 'createdAt', 'lastAt', 'lastBy', 'lastByName'])
                    && str(newData().title, 150) && str(newData().text, 3000)
                    && (!('photo' in newData()) || str(newData().photo, 300000));
      allow update: if isStaff()
                    && ((changed().hasOnly(['lastAt', 'lastBy', 'lastByName', 'replies']) && newData().lastBy == uid())
                        || (changed().hasOnly(['status', 'closedBy', 'closedAt', 'lastAt'])
                            && newData().status in ['open', 'closed'] && (isAdmin() || resource.data.by == uid())));
      allow delete: if isAdmin();
      match /msgs/{mid} {
        allow read: if isStaff();
        allow create: if isStaff() && newData().by == uid()
                      && newData().keys().hasOnly(['text', 'by', 'byName', 'byRole', 'photo', 'at'])
                      && str(newData().text, 3000) && (!('photo' in newData()) || str(newData().photo, 300000));
        allow update: if false;
        allow delete: if isAdmin() || (isStaff() && resource.data.by == uid());
      }
    }
  }
}
